# ---------------------------------------------------------------------------
# django-forge — environment template
# ---------------------------------------------------------------------------
# Copy to .env and adjust:
#
#     cp .env.example .env
#
# .env is git-ignored and personal; THIS file is committed and must never
# contain a real credential. Every value below is a safe placeholder.
#
# You do not need a .env to get started: the development layer works with
# nothing set. This file exists so you can see what is available, and so
# production deployments know what they must supply.
#
# Values are parsed with types (see config/settings/base.py). Booleans accept
# true/1/yes/on and false/0/no/off — the string "False" is correctly False,
# which is the bug this parsing exists to prevent.

# ---------------------------------------------------------------------------
# Django — which settings layer, and its configuration
# ---------------------------------------------------------------------------

# Which settings layer to load. There is deliberately no default in the code:
# guessing one is how a production process ends up on development settings.
#
# COMMENTED OUT ON PURPOSE, for the same reason as DJANGO_DEBUG below: a .env is
# shared by both Compose profiles, so setting it here would apply to BOTH — and
# a value meant for local work would silently make the production-like profile
# run development settings. Each Compose service pins its own layer.
#
# Set it only for host-side commands, e.g.
#   DJANGO_SETTINGS_MODULE=config.settings.development python manage.py shell
#   config.settings.development | config.settings.production | config.settings.test
# DJANGO_SETTINGS_MODULE=config.settings.development

# Secret key used for sessions, signed cookies and password resets.
#   development : optional — a random key is generated when unset. The cost is
#                 that it changes on every restart, so logins do not survive a
#                 reload. Set one here to keep sessions across restarts.
#   production  : REQUIRED. Startup fails without it, on purpose — a shared
#                 fallback would be identical in every project forged from this
#                 template, making every session cookie forgeable.
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# Boolean. Verbose error pages with tracebacks and local variables.
#   development : defaults to true already — you do not need to set this
#   production  : forced false; setting this truthy makes startup FAIL rather
#                 than silently ignoring you
#
# COMMENTED OUT ON PURPOSE. A .env is shared by both profiles, so a truthy
# value here makes `make up-prod` refuse to start. Uncomment only if you need
# to force debug OFF in development.
# DJANGO_DEBUG=true

# Comma-separated list of hostnames Django will serve.
#   development : defaults to localhost,127.0.0.1,0.0.0.0,app,[::1]
#   production  : REQUIRED. Django's Host-header protection depends on it.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,app

# --- production transport security (production layer only) ------------------
# All optional; the defaults are the safe ones. See docs/layout.md.

# Redirect HTTP to HTTPS. Set false when TLS terminates at a load balancer that
# already redirects, otherwise Django redirects a second time.
# DJANGO_SECURE_SSL_REDIRECT=true

# Trust X-Forwarded-Proto from an upstream proxy. OFF by default and dangerous
# to enable casually: if the app is reachable directly, a client can forge the
# header and convince Django a plaintext request was secure. Enable ONLY behind
# a proxy that overwrites it on every request.
# DJANGO_TRUST_PROXY_SSL_HEADER=false

# HSTS max-age in seconds. Defaults to 3600 (one hour) on purpose — browsers
# cache this, so advertising a year before HTTPS is proven stable can make the
# site unreachable for a year. Ramp: 3600 -> 86400 -> 31536000.
# DJANGO_SECURE_HSTS_SECONDS=3600
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# DJANGO_SECURE_HSTS_PRELOAD=false

# Comma-separated origins allowed to submit cross-origin POSTs.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com

# ---------------------------------------------------------------------------
# Database — PostgreSQL 17.6
# ---------------------------------------------------------------------------
# Development defaults. These are throwaway values that protect nothing; a real
# deployment must supply its own.
POSTGRES_USER=forge
POSTGRES_PASSWORD=forge
POSTGRES_DB=forge

# Compose builds this for the app from the three values above, so you normally
# do not set it here. It is REQUIRED — there is deliberately no fallback,
# because defaulting to SQLite would run your commands against a different
# engine than the container uses, without saying so.
# DATABASE_URL=postgresql://forge:forge@db:5432/forge

# Seconds to keep a database connection open for reuse. 0 = a new connection
# per request (Django's default: always correct, and wasteful).
#
# ⚠️  total connections ≈ workers × THREADS PER WORKER
#
# Not workers alone. Under ASGI, sync views run in a threadpool and Django
# connections are thread-local, so each busy thread holds its own. Measured on
# this stack: 20 concurrent requests to ONE uvicorn process held 20
# connections, against PostgreSQL's default max_connections of 100.
#
# Raising worker or thread counts multiplies this. Exceeding max_connections
# refuses new connections outright. At scale the answer is PgBouncer, not a
# larger max_connections — each connection costs memory server-side.
# DJANGO_CONN_MAX_AGE=60

# Development superuser, created by `make seed`. Django's own variable names,
# so `createsuperuser --noinput` works from the same three.
#
# Leaving these unset gives you admin / admin, which is fine here and would not
# be anywhere else. That default is safe only because seeding refuses to run
# unless settings.SEED_ENABLED is true — and only the development and test
# layers set it, in code, never from this file. The default and the guard are a
# pair; do not weaken one without the other.
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=admin@example.com
# DJANGO_SUPERUSER_PASSWORD=admin

# DJANGO_TEST_DATABASE_URL — do NOT set this here.
#
# It selects the database the TEST suite runs against, and `make test-db` sets
# it inside the container. Left unset, `make test` uses in-memory SQLite: fast,
# and it needs no container at all.
#
# It is a separate variable from DATABASE_URL precisely so that a value in this
# file cannot redirect the test suite at a database port that is not published —
# which would make `make test` fail on your machine and nowhere else.

# ⚠️  WHICH COMMAND DESTROYS YOUR LOCAL DATA
#
#     make down                 stops containers, KEEPS the database
#     docker compose down -v    DELETES the database volume — unrecoverable
#
# The difference is one flag and there is no confirmation prompt. `make down`
# never passes -v, so the destructive form has to be typed deliberately.
#
# `make db-dump` is the way back: it writes a dump to backups/ (git-ignored),
# and `make db-restore FILE=...` rebuilds the database from one. Take a dump
# before anything risky. It is a local convenience, NOT a backup strategy —
# docs/backups.md is explicit about the difference and why it matters.
#
# The database port is NOT published to the host, so it cannot collide with a
# locally-installed PostgreSQL. To reach it from a GUI client, add a personal
# docker-compose.override.yml (git-ignored) with:
#     services: {db: {ports: ["5433:5432"]}}

# Integer, seconds. How long the entrypoint waits for the database before
# giving up. Only used when DATABASE_URL is set.
DB_WAIT_TIMEOUT=30

# ---------------------------------------------------------------------------
# Container and Compose
# ---------------------------------------------------------------------------

# Host ports. Change these if 8000 or 8001 are already taken on your machine;
# the ports inside the container do not change.
APP_PORT=8000
APP_PROD_PORT=8001

# The uid/gid the development image is built with, so files written through the
# bind mount are owned correctly on both sides. The Makefile sets these from
# `id -u` / `id -g`, so you normally do not need them here. Matters on Linux;
# macOS hides the problem behind its filesystem translation layer.
APP_UID=1000
APP_GID=1000

# Space-separated names the entrypoint requires to be present before the
# application starts. Empty by default. Use it to fail fast on a deployment
# that forgot a variable, e.g.
#   APP_REQUIRED_VARS=DJANGO_SECRET_KEY DJANGO_ALLOWED_HOSTS DATABASE_URL
APP_REQUIRED_VARS=
