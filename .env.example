# ---------------------------------------------------------------------------
# django-forge — environment template
# ---------------------------------------------------------------------------
# Copy to .env and adjust:
#
#     cp .env.example .env
#
# .env is git-ignored and personal; THIS file is committed and must never
# contain a real credential. Every value below is a safe placeholder.
#
# You do not need a .env to get started: the development layer works with
# nothing set. This file exists so you can see what is available, and so
# production deployments know what they must supply.
#
# Values are parsed with types (see config/settings/base.py). Booleans accept
# true/1/yes/on and false/0/no/off — the string "False" is correctly False,
# which is the bug this parsing exists to prevent.

# ---------------------------------------------------------------------------
# Django — which settings layer, and its configuration
# ---------------------------------------------------------------------------

# REQUIRED. Which settings layer to load. There is deliberately no default:
# guessing one is how a production process ends up on development settings.
# Both Compose profiles set this for you.
#   config.settings.development | config.settings.production | config.settings.test
DJANGO_SETTINGS_MODULE=config.settings.development

# Secret key used for sessions, signed cookies and password resets.
#   development : optional — a random key is generated when unset. The cost is
#                 that it changes on every restart, so logins do not survive a
#                 reload. Set one here to keep sessions across restarts.
#   production  : REQUIRED. Startup fails without it, on purpose — a shared
#                 fallback would be identical in every project forged from this
#                 template, making every session cookie forgeable.
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# Boolean. Verbose error pages with tracebacks and local variables.
#   development : defaults to true
#   production  : forced false; setting this truthy makes startup FAIL rather
#                 than silently ignoring you
DJANGO_DEBUG=true

# Comma-separated list of hostnames Django will serve.
#   development : defaults to localhost,127.0.0.1,0.0.0.0,app,[::1]
#   production  : REQUIRED. Django's Host-header protection depends on it.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,app

# ---------------------------------------------------------------------------
# Database — not yet active (M4-01 adds the PostgreSQL service)
# ---------------------------------------------------------------------------
# The container entrypoint already honours this: when set, it waits for the
# database to accept queries before starting the application. Left unset, that
# wait is skipped. Settings do not read it yet — M4-02 wires it in.
# DATABASE_URL=postgresql://forge:forge@db:5432/forge

# Integer, seconds. How long the entrypoint waits for the database before
# giving up. Only used when DATABASE_URL is set.
DB_WAIT_TIMEOUT=30

# ---------------------------------------------------------------------------
# Container and Compose
# ---------------------------------------------------------------------------

# Host ports. Change these if 8000 or 8001 are already taken on your machine;
# the ports inside the container do not change.
APP_PORT=8000
APP_PROD_PORT=8001

# The uid/gid the development image is built with, so files written through the
# bind mount are owned correctly on both sides. The Makefile sets these from
# `id -u` / `id -g`, so you normally do not need them here. Matters on Linux;
# macOS hides the problem behind its filesystem translation layer.
APP_UID=1000
APP_GID=1000

# Space-separated names the entrypoint requires to be present before the
# application starts. Empty by default. Use it to fail fast on a deployment
# that forgot a variable, e.g.
#   APP_REQUIRED_VARS=DJANGO_SECRET_KEY DJANGO_ALLOWED_HOSTS DATABASE_URL
APP_REQUIRED_VARS=
